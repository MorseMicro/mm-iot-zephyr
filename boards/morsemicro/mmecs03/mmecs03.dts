/dts-v1/;
#include <st/u5/stm32u585Xi.dtsi>
#include <st/u5/stm32u585ritxq-pinctrl.dtsi>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	model = "Morse Micro MMECS03 Demonstration Board";
	compatible = "morsemicro,mmecs03";

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;

		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	status_leds {
		compatible = "gpio-leds";
		status_led_blue: led_b {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "BLUE";
		};
		status_led_green: led_g {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			label = "GREEN";
		};
		status_led_red: led_r {
			gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
			label = "RED";
		};
	};

	aliases {
		led0 = &status_led_blue;
		led1 = &status_led_green;
		led2 = &status_led_red;

		watchdog0 = &iwdg;
	};
};

/* No HSE crystal is fitted on MMECS03; SYSCLK is derived from the
 * internal MSI oscillator instead.
 */
&clk_hsi48 {
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&clk_msis {
	status = "okay";
	msi-range = <0>;
};

&pll1 {
	div-m = <3>;
	mul-n = <10>;
	div-q = <2>;
	div-r = <1>;
	clocks = <&clk_msis>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

stm32_lp_tick_source: &lptim1 {
	clocks = <&rcc STM32_CLOCK_BUS_APB3 0x00000800>,
		<&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};

&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pc1 &lpuart1_rx_pb10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* MM8108 Wi-Fi HaLow module SPI connections */

&pinctrl {
	spi1_cs_pd2: spi1_cs_pd2 {
		pinmux = <STM32_PINMUX('D', 2, GPIO)>;
		bias-pull-down;
		drive-push-pull;
		slew-rate = "low-speed";
	};

	mm8108_busy_pb15: mm8108_busy_pb15 {
		pinmux = <STM32_PINMUX('B', 15, GPIO)>;
		bias-pull-down;
		slew-rate = "low-speed";
	};

	mm8108_int_pb2: mm8108_int_pb2 {
		pinmux = <STM32_PINMUX('B', 2, GPIO)>;
		bias-pull-up;
		slew-rate = "low-speed";
	};
};

&spi1_sck_pa5 {
	drive-push-pull;
	bias-pull-down;
	slew-rate = "very-high-speed";
};

&spi1_miso_pb4 {
	drive-push-pull;
	bias-pull-down;
	slew-rate = "very-high-speed";
};

&spi1_mosi_pb5 {
	drive-push-pull;
	bias-pull-down;
	slew-rate = "very-high-speed";
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pb4 &spi1_mosi_pb5 &spi1_cs_pd2
		     &mm8108_busy_pb15 &mm8108_int_pb2>;
	pinctrl-names = "default";
	cs-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;

	//         channel slot channel-config (st,stm32-dma_v2.yaml)
	dmas = <&gpdma1 15 7 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_VERY_HIGH)>,
	       <&gpdma1 14 6 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_VERY_HIGH)>;
	dma-names = "tx", "rx";

	morsemicro_wifi_spi: morsemicro@0 {
		status = "okay";
		compatible = "morsemicro,mm8108";
		spi-max-frequency = <40000000>;
		reg = <0>;

		bcf = "bcf_mf15457.mbin";
		busy-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>;
		resetn-gpios = <&gpioc 12 GPIO_ACTIVE_LOW>;
		spi-irq-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
	};
};

&rng {
	status = "okay";
};

&iwdg {
	status = "okay";
};

&gpdma1 {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@180000 {
			label = "storage";
			reg = <0x180000 0x00008000>;
		};
	};
};
